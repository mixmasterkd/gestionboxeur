{
  "name": "gestionboxeur",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "VITE_LOCAL_SANDBOX=1 vite --host 192.168.50.123 --port 4173 --strictPort",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "test:e2e": "playwright test",
    "test:local": "playwright test --config playwright.local.config.js",
    "test:preprod": "playwright test --config playwright.preprod.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "sortablejs": "1.15.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "happy-dom": "^20.8.4",
    "vite": "8.3.0"
  }
}
